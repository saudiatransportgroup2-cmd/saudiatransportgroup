# Optional settings. Nothing here is required for the site to work.
#
# Where to set them on Cloudflare:
#   Workers & Pages > your Worker > Settings > Variables and Secrets
#   - Names starting with NEXT_PUBLIC_ are read at BUILD time, so add them under
#     Settings > Build > Variables and secrets (build), not only at runtime.
#   - Keys and tokens (RESEND_API_KEY) should be added as Secrets.

# --- Quote form delivery (runtime) --------------------------------------------
# Email each enquiry through Resend (https://resend.com):
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=info@example.com            # comma-separated for several inboxes
ENQUIRY_FROM_EMAIL="Website enquiries <enquiries@yourdomain.com>"   # needs a verified sender domain

# Or post each enquiry as JSON to Slack, Make, Zapier, a CRM, etc.:
ENQUIRY_WEBHOOK_URL=

# Every valid enquiry is also written to the Worker log (Workers > Logs), whatever is set above.

# --- Analytics (build time) ---------------------------------------------------
# Google Analytics 4. Also tracks WhatsApp, phone and quote-button clicks as events.
NEXT_PUBLIC_GA_ID=
# Cloudflare Web Analytics token (alternative or addition).
NEXT_PUBLIC_CF_BEACON_TOKEN=
